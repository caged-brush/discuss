<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".CreateGroupChat">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/edtGroupTitle"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:backgroundTint="#C7D1D9"
            android:background="#C7D1D9"
            android:gravity="center"
            android:hint="Add Group Chat Title"
            android:inputType="textCapWords"
            android:maxLength="60"
            android:maxLines="1"
            android:padding="16dp"
            android:textColor="#000000"
            android:textColorHint="#333333"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Contacts"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollContacts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#C7D1D9"
            android:padding="4dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/contactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContact1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Contact username 1"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContact2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Contact username 2"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContact3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Contact username 3"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContact4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Contact username 4"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContact5"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Contact username 5"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnContact6"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Contact username 6"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/scrollSavedArticles"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            android:background="#C7D1D9"
            android:padding="4dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/articlesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnArticle1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#FF0000"
                    android:text="Chosen Saved Article"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnArticle2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Saved Article"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnArticle3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#666666"
                    android:text="Saved Article"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShareArticle"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:backgroundTint="#C7D1D9"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Share Article"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>