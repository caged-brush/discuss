<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".ArticleBrowse">

    <!-- Collapsible navigation bar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/article_browse_contact_button"
            style="@style/NavRailButton"
            android:layout_marginStart="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/nav_toggle"
            android:src="@drawable/ic_nav_menu" />

        <FrameLayout
            android:id="@+id/article_browse_contactBar"
            android:layout_width="@dimen/ArticleBrowseExpandedCB"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="15dp"
                android:paddingBottom="15dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/nav_contacts"
                    style="@style/NavRailButton"
                    android:contentDescription="@string/nav_contacts"
                    android:src="@drawable/ic_nav_contacts"
                    android:tooltipText="@string/nav_contacts" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/nav_groups"
                    style="@style/NavRailButton"
                    android:contentDescription="@string/nav_groups"
                    android:src="@drawable/ic_nav_chat"
                    android:tooltipText="@string/nav_groups" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/nav_profile"
                    style="@style/NavRailButton"
                    android:contentDescription="@string/nav_profile"
                    android:src="@drawable/ic_nav_profile"
                    android:tooltipText="@string/nav_profile" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingHorizontal="8dp"
            android:text="@string/browse_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/article_browse_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/article_browse_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="4dp"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/article_browse_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
