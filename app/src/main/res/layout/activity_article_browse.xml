<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="horizontal"
    tools:context=".ArticleBrowse">

    <!--
        Navigation rail. Every child is centred on the same axis (gravity on this column),
        so the toggle and the icons below it can never drift apart.
    -->
    <LinearLayout
        android:id="@+id/browseRail"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <ImageButton
            android:id="@+id/article_browse_contact_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@string/nav_toggle"
            android:src="@drawable/ic_nav_menu"
            app:tint="?attr/colorOnPrimary" />

        <LinearLayout
            android:id="@+id/navItems"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rail_pill"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/nav_contacts"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_contacts"
                android:padding="10dp"
                android:src="@drawable/ic_nav_contacts"
                android:tooltipText="@string/nav_contacts"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/nav_groups"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_groups"
                android:padding="10dp"
                android:src="@drawable/ic_nav_chat"
                android:tooltipText="@string/nav_groups"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/nav_videos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_videos"
                android:padding="10dp"
                android:src="@drawable/ic_nav_video"
                android:tooltipText="@string/nav_videos"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/nav_profile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_profile"
                android:padding="10dp"
                android:src="@drawable/ic_nav_profile"
                android:tooltipText="@string/nav_profile"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingEnd="16dp"
            android:text="@string/browse_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:text="@string/browse_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="RtlSymmetry" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            tools:ignore="RtlSymmetry">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/article_browse_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/article_browse_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/article_browse_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="12dp"
                android:drawableTint="?attr/colorOutline"
                android:drawableTop="@drawable/ic_empty_bookmark"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
