<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|top"
    android:orientation="horizontal"
    android:paddingVertical="3dp">

    <!-- Sender initials; hidden on your own messages -->
    <TextView
        android:id="@+id/messageAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="B" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/messageBubble"
        style="@style/Widget.App.Card.Bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <!-- Hidden on your own messages -->
            <TextView
                android:id="@+id/tvSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Bob" />

            <!-- Shared article card -->
            <LinearLayout
                android:id="@+id/articleBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvArticleTile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tile"
                    android:gravity="center"
                    android:text="📄"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSharedArticleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:maxLines="2"
                        android:maxWidth="200dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="AI Tutors Arrive in the Classroom" />

                    <TextView
                        android:id="@+id/tvSharedArticleCta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_article_cta"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Photo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginVertical="4dp"
                android:background="#22000000"
                android:contentDescription="@string/chat_image_description"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Media"
                tools:visibility="visible" />

            <!-- Voice message -->
            <LinearLayout
                android:id="@+id/audioBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@string/chat_voice_play"
                    android:padding="8dp"
                    android:src="@drawable/ic_play" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressAudio"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:max="1000"
                    app:trackCornerRadius="2dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="36dp"
                    android:textSize="13sp"
                    tools:text="0:12" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:textSize="15sp"
                tools:text="Interesting read, what do you think?" />

            <TextView
                android:id="@+id/tvMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                tools:text="4:12 PM" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
