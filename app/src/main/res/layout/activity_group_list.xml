<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding"
        android:text="@string/group_chats"
        android:textAppearance="@style/TextAppearance.Discuss.Heading" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginBottom="8dp"
        android:text="@string/new_group" />

    <ListView
        android:id="@+id/groupsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding"
        android:divider="?attr/colorOutlineVariant"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/groupsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding"
        android:text="@string/no_groups"
        android:textAppearance="@style/TextAppearance.Discuss.Supporting" />
</LinearLayout>
