<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:orientation="vertical"
    tools:context=".WelcomePage">

    <!-- Brand area; its paddings are set from the window insets in code -->
    <LinearLayout
        android:id="@+id/welcomeHero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/WelcomePage_Logo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_logo_halo"
            android:contentDescription="@string/app_name"
            android:padding="14dp"
            android:src="@drawable/ic_logo_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/on_hero"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_tagline"
            android:textColor="@color/on_hero_variant"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/welcomeSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical">

        <Button
            android:id="@+id/WelcomePage_Login"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/WelcomePage_Login" />

        <Button
            android:id="@+id/WelcomePage_SignUp"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/WelcomePage_SignUp" />

        <Button
            android:id="@+id/WelcomePage_forgotCreds"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/WelcomePage_ForgotCreds" />
    </LinearLayout>
</LinearLayout>
